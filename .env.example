# HAL Dashboard environment configuration.
#
# Install as a root-owned file, e.g.:
#   sudo install -m 0640 -o root -g hal-dashboard .env /etc/hal-dashboard/hal-dashboard.env
#
# Generate a strong token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Required (unless HAL_DASHBOARD_AUTH_DISABLED=true). Requests authenticate with
# the X-Hal-Token header. Empty values and obvious placeholders (changeme,
# replace-me, ...) are rejected at startup.
HAL_DASHBOARD_TOKEN=__REPLACE_WITH_A_STRONG_GENERATED_TOKEN__

# Optional: explicit opt-in reverse-proxy authentication mode. Absent/empty or
# one of 0, false, no, off keeps token auth (the secure default). One of
# 1, true, yes, on (case-insensitive) DISABLES the dashboard's own token check:
# HAL_DASHBOARD_TOKEN is then not required and every API route works without
# X-Hal-Token. Any other value aborts startup.
#
# WARNING: this is a deployment switch, not a credential. The app never trusts
# X-Forwarded-* or any proxy header as proof of authentication. Set it true
# ONLY when (a) your reverse proxy authenticates EVERY request and (b) direct
# access to the backend port is blocked by firewall/network policy. Binding the
# backend on 0.0.0.0 without such restrictions lets anyone who can reach the
# port control systemd with no token at all.
#HAL_DASHBOARD_AUTH_DISABLED=false

# Optional: path to the systems TOML config file.
# Defaults to ./config/systems.toml relative to the installed package when unset.
#HAL_DASHBOARD_CONFIG=/etc/hal-dashboard/systems.toml

# Optional: comma-separated exact origins (scheme://host[:port]) allowed to send
# POST/PUT requests with a browser Origin header. Only exact matches are accepted;
# no wildcards. When unset, only the Host-derived same origin is accepted.
#HAL_DASHBOARD_ALLOWED_ORIGINS=https://hal.lan.example
