# EXAMPLE systemd unit for the SGLang Qwen3.8 Flash Next model server.
# This file is NOT installable as-is: every __PLACEHOLDER__ is intentional so
# the unit fails closed until you review it. Copy to
# /etc/systemd/system/sglang-qwen38-flash-next.service and fill in your real
# venv and model paths. The polkit rule must list the same unit name.
#
# SHARED LLM ENDPOINT IDENTITY (applies to all three model backends):
#   The dashboard switches between exactly one LLM backend at a time, so all
#   three bind the SAME loopback port and serve the SAME model name. External
#   LLM clients therefore always use base URL http://127.0.0.1:8000/v1 and
#   model name 'hal', no matter which backend is currently active
#   (no proxy layer needed; the mutually exclusive services take turns on the
#   port). config/systems.toml checks http://127.0.0.1:8000/health.
#     - LLM_PORT: common loopback port, must be 8000.
#     - SGLang required args: --host 127.0.0.1 --port $LLM_PORT
#                             --served-model-name hal
#   Never run two model services at once: the second bind on :8000 fails.

[Unit]
Description=SGLang - Qwen3.8 Flash Next (GPU 0, creative writing / basic agentic)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__MODEL_USER__
Group=__MODEL_GROUP__
WorkingDirectory=/srv/sglang
EnvironmentFile=/etc/hal-dashboard/sglang-qwen38-flash-next.env
Environment=CUDA_VISIBLE_DEVICES=0
# Shared LLM endpoint identity: every backend listens on 127.0.0.1:$LLM_PORT.
Environment=LLM_PORT=8000

# Compiler toolchain override for SGLang JIT and host-side compilation
# (TorchInductor, Triton, FlashInfer). On some hosts the venv's `gcc-15`/`g++-15`
# wrappers cannot locate `cc1plus`, so the GCC 15 toolchain root must be injected
# explicitly: `g++` must be able to reach its `cc1plus` (e.g. a
# `/usr/local/gcc-15/bin/g++` that resolves it). Define these via
# sglang-qwen38-flash-next.env (preferred) or via Environment= below. These are
# PLACEHOLDERS: replace __CC__/__CXX__/__CUDAHOSTCXX__ with your real GCC 15
# compiler paths, or delete these lines and set the variables in the env file.
Environment=CC=__CC__
Environment=CXX=__CXX__
Environment=CUDAHOSTCXX=__CUDAHOSTCXX__

# PLACEHOLDER (impossible on purpose): replace __SGLANG_VENV__ with your real
# SGLang virtualenv and __MODEL_PATH__ with your real model directory. The
# served model name MUST stay 'hal' and the port MUST stay 8000 so
# external clients are unaffected by model switches.
ExecStart=__SGLANG_VENV__/bin/python -m sglang.launch_server --model-path __MODEL_PATH__ --served-model-name hal --host 127.0.0.1 --port $LLM_PORT

Restart=on-failure
RestartSec=5
# Model load takes roughly 90s per config/systems.toml; give stop plenty of time.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
